# 仅 local 环境使用；复制为 .env 后替换为随机值，绝不提交真实密钥。
MYSQL_DATABASE_ROOT_PASSWORD=<TBD_RANDOM_LOCAL_MYSQL_ROOT_PASSWORD>
MYSQL_APP_PASSWORD=<TBD_RANDOM_LOCAL_MYSQL_APP_PASSWORD>
MYSQL_FLYWAY_USERNAME=root
MYSQL_FLYWAY_PASSWORD=<TBD_RANDOM_LOCAL_MYSQL_ROOT_PASSWORD>
MYSQL_JDBC_URL=jdbc:mysql://127.0.0.1:3306/platform_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_FLYWAY_JDBC_URL=jdbc:mysql://127.0.0.1:3306/?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=investment_app
MYSQL_PASSWORD=<TBD_RANDOM_LOCAL_MYSQL_APP_PASSWORD>
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<TBD_RANDOM_LOCAL_REDIS_PASSWORD>
MINIO_ROOT_USER=<TBD_LOCAL_MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<TBD_RANDOM_LOCAL_MINIO_ROOT_PASSWORD>
# 32-byte master key encoded as Base64, used only by local MinIO static KMS mode.
MINIO_SSE_MASTER_KEY_BASE64=<TBD_BASE64_32_BYTE_LOCAL_MINIO_MASTER_KEY>
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# Client-visible endpoint used only in presigned form URLs. It must be externally reachable in production.
OBJECT_STORAGE_UPLOAD_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=investment-private
OBJECT_STORAGE_ACCESS_KEY=<TBD_LOCAL_MINIO_ROOT_USER>
OBJECT_STORAGE_SECRET_KEY=<TBD_RANDOM_LOCAL_MINIO_ROOT_PASSWORD>
OBJECT_STORAGE_ENCRYPTION_KEY_VERSION=local-minio-static-v1
AUTH_HMAC_KEY=<TBD_BASE64_OR_HIGH_ENTROPY_HMAC_KEY>
AUTH_SESSION_HMAC_KEY=<TBD_BASE64_OR_HIGH_ENTROPY_SESSION_HMAC_KEY>
BOOTSTRAP_ENROLLMENT_SECRET=<TBD_RANDOM_ONE_TIME_LOCAL_BOOTSTRAP_SECRET>
LOCAL_MOCK_LOGIN_CODE=<TBD_LOCAL_LOGIN_CODE>
LOCAL_MOCK_OPENID=<TBD_LOCAL_OPENID>
AUTH_SESSION_TTL=PT12H
# Leave disabled locally unless a reachable XXL-JOB admin is intentionally configured.
XXL_JOB_EXECUTOR_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=<TBD_XXL_JOB_ADMIN_HTTP_URL>
XXL_JOB_EXECUTOR_APP_NAME=investment-api-executor
XXL_JOB_EXECUTOR_ACCESS_TOKEN=<TBD_RANDOM_32_PLUS_CHARACTER_XXL_JOB_ACCESS_TOKEN>
XXL_JOB_EXECUTOR_ADDRESS=<TBD_REACHABLE_EXECUTOR_HTTP_URL_WITH_PORT_9999>
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_EXECUTOR_LOG_PATH=/tmp/investment-xxl-job
XXL_JOB_EXECUTOR_LOG_RETENTION_DAYS=30
XXL_JOB_ADMIN_TIMEOUT_SECONDS=3
