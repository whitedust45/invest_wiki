.strategy-page {
  padding-bottom: 48rpx;
}

.strategy-principle {
  margin-top: 0;
}

.focus-copy {
  color: #2D2B26;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.55;
}

.focus-rule {
  border-top: 2rpx solid #E9E3DA;
  color: #6D675F;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 20rpx;
  padding-top: 18rpx;
}

.loading-card {
  color: #746C62;
  font-size: 26rpx;
  text-align: center;
}

.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.strategy-card {
  border: 2rpx solid transparent;
  margin-top: 0;
  padding: 26rpx;
}

.strategy-card-selected {
  border-color: #C9DCD8;
  box-shadow: 0 10rpx 28rpx rgba(15, 118, 110, 0.08);
}

.strategy-topline,
.strategy-meta-row,
.section-title-row,
.detail-status,
.principle-row {
  display: flex;
}

.strategy-topline {
  align-items: center;
  gap: 16rpx;
}

.strategy-icon {
  align-items: center;
  background: #E8F1EE;
  border-radius: 18rpx;
  color: #146B64;
  display: flex;
  font-size: 21rpx;
  font-weight: 700;
  height: 64rpx;
  justify-content: center;
  width: 64rpx;
}

.strategy-main {
  flex: 1;
  min-width: 0;
}

.strategy-name {
  color: #25231F;
  font-size: 30rpx;
  font-weight: 700;
}

.strategy-subtitle,
.strategy-message,
.detail-copy {
  color: #6D675F;
  font-size: 23rpx;
  line-height: 1.55;
}

.strategy-subtitle {
  margin-top: 5rpx;
}

.status-pill {
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 650;
  padding: 8rpx 14rpx;
  white-space: nowrap;
}

.state-good {
  background: #E1F1E9;
  color: #187152;
}

.state-watch {
  background: #FFF0D8;
  color: #AD6619;
}

.state-blocked {
  background: #EEE9E1;
  color: #766D63;
}

.strategy-meta-row {
  color: #8A8177;
  font-size: 21rpx;
  justify-content: space-between;
  margin-top: 21rpx;
}

.strategy-message {
  border-top: 2rpx solid #EDE7DE;
  margin-top: 15rpx;
  padding-top: 14rpx;
}

.detail-card {
  margin-top: 20rpx;
}

.detail-status {
  align-items: center;
  color: #49443D;
  font-size: 25rpx;
  gap: 12rpx;
  line-height: 1.5;
}

.detail-section {
  margin-top: 26rpx;
}

.detail-section-line {
  border-top: 2rpx solid #E9E3DA;
  padding-top: 23rpx;
}

.detail-label {
  color: #2D2B26;
  font-size: 25rpx;
  font-weight: 700;
  margin-bottom: 9rpx;
}

.detail-input-time {
  color: #8A8177;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.rule-id {
  background: #F3F0EA;
  border-radius: 12rpx;
  color: #5F5A53;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20rpx;
  overflow: hidden;
  padding: 12rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-summary {
  background: #F8F5F0;
  border-radius: 12rpx;
  color: #5F5A53;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20rpx;
  line-height: 1.65;
  margin-top: 14rpx;
  padding: 14rpx;
  white-space: pre-wrap;
}

.rule-editor {
  border-top: 2rpx solid #e9e3da;
  margin-top: 22rpx;
  padding-top: 18rpx;
}

.rule-field-row {
  border-top: 2rpx solid #f0ebe3;
  margin-top: 14rpx;
  padding-top: 14rpx;
}

.rule-field-label {
  color: #4b453e;
  font-size: 23rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}

.rule-field-hint {
  font-size: 20rpx;
  line-height: 1.45;
  margin-top: 6rpx;
}

.history-list {
  border-top: 2rpx solid #E9E3DA;
  margin-top: 20rpx;
  padding-top: 16rpx;
}

.history-heading {
  color: #746C62;
  font-size: 21rpx;
  margin-bottom: 8rpx;
}

.history-row {
  border-top: 2rpx solid #F0EBE3;
  color: #625C54;
  display: flex;
  font-size: 21rpx;
  gap: 12rpx;
  justify-content: space-between;
  line-height: 1.5;
  padding: 12rpx 0;
}

.history-evaluation {
  display: block;
}

.history-evaluation view + view {
  color: #81786E;
  margin-top: 5rpx;
}

.history-status {
  color: #0F766E;
  font-weight: 700;
}

.compact-button {
  font-size: 25rpx;
  margin-top: 17rpx;
}

.reference-nav-form {
  margin-top: 18rpx;
}

.strategy-metrics {
  border-top: 2rpx solid #ece7de;
  margin-top: 18rpx;
  padding-top: 6rpx;
}

.strategy-metric-row {
  align-items: center;
  border-bottom: 2rpx solid #f1ede6;
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
}

.strategy-metric-label {
  color: #766d63;
  font-size: 23rpx;
}

.strategy-metric-value {
  color: #28362f;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 23rpx;
  font-weight: 650;
  text-align: right;
}

.missing-input-panel {
  background: #fff8ec;
  border: 1rpx solid #f2dfbc;
  border-radius: 12rpx;
  color: #895d1d;
  margin-top: 16rpx;
  padding: 14rpx;
}

.missing-input-title {
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.missing-input-item {
  font-size: 22rpx;
  line-height: 1.6;
}

.history-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
  margin-top: 8rpx;
}

.history-metric {
  color: #6e685f;
  font-size: 20rpx;
  line-height: 1.5;
}

.principle-card {
  margin-top: 20rpx;
}

.principle-row {
  align-items: flex-start;
  border-top: 2rpx solid #E9E3DA;
  color: #454038;
  font-size: 25rpx;
  gap: 16rpx;
  line-height: 1.6;
  padding: 18rpx 0;
}

.principle-index {
  color: #0F766E;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22rpx;
  font-weight: 700;
}
